# Blockcraft – Konfiguration
# Kopiere diese Datei nach `.env` und passe die Werte an. `.env` wird NICHT committet.
#
# WICHTIG: Alle Variablen mit Präfix VITE_ landen im Client-Build und sind damit
# öffentlich sichtbar. Niemals Geheimnisse in VITE_-Variablen speichern!

# ---------------------------------------------------------------------------
# Client (wird beim `pnpm build` in den statischen Build eingebacken)
# ---------------------------------------------------------------------------

# URL des Spielservers (http/https). Leer = gleicher Host wie die Seite
# (Standard, wenn der Render-Dienst Client und Server gemeinsam ausliefert).
VITE_SERVER_URL=

# Vorschlag für den Seed beim Erstellen einer neuen Welt (leer = zufällig).
VITE_DEFAULT_SEED=

# Debug-Funktionen (Debug-Overlay beim Start, Test-Hooks unter window.__bc).
VITE_DEBUG=false

# Render-Distanz in Chunks: Standardwert und erlaubtes Maximum im Einstellungsmenü.
VITE_DEFAULT_RENDER_DISTANCE=8
VITE_MAX_RENDER_DISTANCE=16

# Dauer eines vollen Tag-Nacht-Zyklus in Sekunden.
VITE_DAY_LENGTH_SECONDS=1200

# Anzahl Web Worker für Generierung/Meshing (0 = automatisch: Kerne - 1, max. 4).
VITE_WORKER_COUNT=0

# ---------------------------------------------------------------------------
# Server (Render Web Service)
# ---------------------------------------------------------------------------

# Port – wird auf Render automatisch gesetzt.
PORT=8080

# Erlaubte Origins für WebSocket-Verbindungen, kommagetrennt.
# Leer = nur gleicher Host. `*` = alle (nur für Tests!).
ALLOWED_ORIGINS=

# Ordner mit dem gebauten Client (relativ zum Repo-Root).
CLIENT_DIST_DIR=apps/client/dist

# Limits (konservativ für den Render-Free-Plan).
MAX_ROOMS=3
MAX_PLAYERS_PER_ROOM=4
ROOM_CODE_LENGTH=6
TICK_RATE=20
MAX_VIEW_DISTANCE=6
ROOM_IDLE_TIMEOUT_MIN=10
JOIN_RATE_LIMIT_PER_MIN=30

# Log-Level: debug | info | warn | error
LOG_LEVEL=info
